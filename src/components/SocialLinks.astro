---
import { Icon } from "astro-icon/components";

const socialLinks = [
  {
    label: "GitHub",
    link: "https://github.com/akmatoff",
    icon: "ri:github-fill",
    isTargetBlank: true,
  },
  {
    label: "Linkedin",
    link: "https://www.linkedin.com/in/akmatoff/",
    icon: "ri:linkedin-fill",
    isTargetBlank: true,
  },
  {
    label: "E-mail",
    link: "mailto:azim.akmatov1@gmail.com",
    icon: "ri:mail-fill",
    isTargetBlank: true,
  },
];
---

<section class="w-full py-2">
  <div class="flex space-x-6">
    {
      socialLinks.map((link) => (
        <div class="flex items-center space-x-2">
          <a href={link.link} target={link.isTargetBlank ? "_blank" : "_self"}>
            <Icon name={link.icon} class="text-xl" />
          </a>
          <a
            href={link.link}
            class="text-sm"
            target={link.isTargetBlank ? "_blank" : "_self"}
          >
            {link.label}
          </a>
        </div>
      ))
    }
  </div>
</section>
