---
import SocialLinks from "../components/SocialLinks.astro";
import "../main.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Azim Akmatov | TypeScript Developer, Music Producer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Commissioner:wght@100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-background text-foreground w-full min-h-screen">
    <main class="w-full min-h-screen">
      <div
        class="flex flex-col items-center p-2 w-full md:w-[30%] mx-auto min-h-screen"
      >
        <div class="w-full flex-grow">
          <slot />
        </div>
        <SocialLinks />
      </div>
    </main>
  </body>
</html>
